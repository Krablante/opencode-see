{
  "name": "opencode-see",
  "private": true,
  "version": "0.4.1",
  "description": "Show local or session images to OpenCode models through native vision or delegation.",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "src",
    "examples",
    "assets",
    "docs",
    "*.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "demos": "node --import tsx scripts/generate-demos.mjs",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "vision",
    "image",
    "screenshot",
    "plugin"
  ],
  "author": "Krablante",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krablante/opencode-see.git"
  },
  "bugs": {
    "url": "https://github.com/Krablante/opencode-see/issues"
  },
  "homepage": "https://github.com/Krablante/opencode-see#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.25"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
